{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/biobitworks/hydradg/schemas/agent_model_handoff_receipt.schema.json",
  "title": "HydraDG Agent/Model Handoff Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "handoff_id",
    "timestamp_utc",
    "actor_class",
    "actor_id",
    "execution_host",
    "repo",
    "branch",
    "git_commit",
    "parent_handoff_sha256",
    "input_dependencies",
    "evidence_class",
    "transformation_class",
    "claim_ceiling",
    "signature",
    "merkle_mmr"
  ],
  "properties": {
    "schema": {"const": "hydradg.agent_model_handoff.v1"},
    "handoff_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "minLength": 1},
    "actor_class": {
      "type": "string",
      "enum": [
        "HUMAN",
        "CHATGPT",
        "ANTIGRAVITY",
        "CLAUDE",
        "WATCHTOWER",
        "OLLARMA",
        "OLLAMA_MODEL",
        "DETERMINISTIC_TOOL",
        "HYDRADB",
        "GIT_GITHUB",
        "OTHER_AGENT"
      ]
    },
    "actor_id": {"type": "string", "minLength": 1},
    "execution_host": {"type": ["string", "null"]},
    "hardware_identity_sha256": {"$ref": "#/$defs/sha256OrState"},
    "repo": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "git_commit": {"type": "string", "minLength": 1},
    "parent_handoff_sha256": {"$ref": "#/$defs/sha256OrState"},
    "input_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sha256", "evidence_class"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256OrState"},
          "evidence_class": {"type": "string", "minLength": 1},
          "source": {"type": ["string", "null"]}
        }
      }
    },
    "prompt_sha256": {"$ref": "#/$defs/sha256OrState"},
    "request_sha256": {"$ref": "#/$defs/sha256OrState"},
    "output_sha256": {"$ref": "#/$defs/sha256OrState"},
    "model": {
      "type": ["object", "null"],
      "properties": {
        "bridge": {"type": ["string", "null"]},
        "requested_name": {"type": ["string", "null"]},
        "approved_name": {"type": ["string", "null"]},
        "runtime_name": {"type": ["string", "null"]},
        "runtime_digest": {"type": ["string", "null"]},
        "generation_config_sha256": {"$ref": "#/$defs/sha256OrState"},
        "infrastructure_outcome": {"type": ["string", "null"]},
        "scientific_outcome": {"type": ["string", "null"]}
      }
    },
    "fco": {
      "type": ["object", "null"],
      "properties": {
        "state": {"type": "string"},
        "object_id": {"type": ["string", "null"]},
        "receipt_sha256": {"$ref": "#/$defs/sha256OrState"}
      }
    },
    "fcg": {
      "type": ["object", "null"],
      "properties": {
        "state": {"type": "string"},
        "root_before": {"$ref": "#/$defs/sha256OrState"},
        "root_after": {"$ref": "#/$defs/sha256OrState"},
        "append_receipt_sha256": {"$ref": "#/$defs/sha256OrState"}
      }
    },
    "hydradb": {
      "type": ["object", "null"],
      "properties": {
        "projection_state": {"type": "string"},
        "projection_receipt_sha256": {"$ref": "#/$defs/sha256OrState"},
        "readback_state": {"type": "string"},
        "readback_receipt_sha256": {"$ref": "#/$defs/sha256OrState"}
      }
    },
    "evidence_class": {"type": "string", "minLength": 1},
    "transformation_class": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "signature": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "NOT_SIGNED",
            "PENDING_EXTERNAL_PRIVATE_KEY_OPERATION",
            "SIGNED",
            "SIGNATURE_VERIFIED",
            "SIGNATURE_FAILED"
          ]
        },
        "algorithm": {"type": ["string", "null"]},
        "public_key_id": {"type": ["string", "null"]},
        "signed_scope": {"type": ["string", "null"]},
        "signature_path": {"type": ["string", "null"]},
        "verification_receipt_sha256": {"$ref": "#/$defs/sha256OrState"}
      }
    },
    "merkle_mmr": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "root": {"$ref": "#/$defs/sha256OrState"},
        "receipt_sha256": {"$ref": "#/$defs/sha256OrState"}
      }
    },
    "next_actor": {"type": ["string", "null"]},
    "next_handoff_state": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "sha256OrState": {
      "type": ["string", "null"],
      "anyOf": [
        {"pattern": "^[0-9a-f]{64}$"},
        {"enum": [
          "GENESIS",
          "NOT_AVAILABLE",
          "NOT_APPLICABLE",
          "NOT_APPENDED",
          "NOT_PROJECT_COMMITTED",
          "PENDING_ORIGINAL_TURN_CAPTURE",
          "PENDING_EXTERNAL_PRIVATE_KEY_OPERATION"
        ]},
        {"type": "null"}
      ]
    }
  }
}
