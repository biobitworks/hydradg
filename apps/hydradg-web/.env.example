# Vercel public control plane — server-only documented variables.
# Never set NEXT_PUBLIC_* for these. Never log or commit values.
# TAVILY_API_KEY
# RUNTYPE_API_KEY
# RUNTYPE_API_URL
# DAYTONA_API_KEY
# DAYTONA_API_URL
# HYDRA_DB_API_KEY
# HYDRADB_DATABASE
# HYDRADB_COLLECTION
# HYDRADB_API_URL
# TENKI_API_KEY
#
# Tenki sandbox must not execute until operator completes:
#   tenki login
#   tenki status
#
# Ollarma, GUM Doctor, Yappy local agent, Cotal local mesh, and signing
# private keys are NOT hosted on Vercel. magicSTUDIObox.local remains
# scientific execution authority.

# Graph backend: hydradb-http (HydraDB Graph Database)
GRAPH_BACKEND=hydradb-http

# Pinned self-hosted HydraDB graph adapter used by the local judge demo.
# Fail-safe example: use an isolated HydraDG graph ID and namespace, never the shared/default graph or namespace.
HYDRADB_HTTP_URL=http://127.0.0.1:8443
HYDRADB_GRAPH_ID=hydradg-judge-repro
HYDRADB_GRAPH_NAMESPACE=hydradg-judge-repro
HYDRADB_CELL_ID=cell-0
HYDRADB_AUTH_TOKEN=

# Best Use local server: LongMemEval cases, retrieval, live FCG perturbation, receipts.
# Configure locally only. Leave unset on the public Vercel deployment.
BEST_USE_SERVER_URL=http://127.0.0.1:8787

# Official HydraDB hosted API v2 lane.
# Never commit the API key. Use Vercel encrypted environment variables, .env.local, shell env, or another secret store.
# Canonical v2 names are database / collection. The app may read legacy tenant/sub-tenant aliases only for compatibility.
HYDRA_DB_API_KEY=
HYDRADB_DATABASE=hydradg
# Set HYDRADB_COLLECTION only if the HydraDB connector/import was explicitly scoped to a collection.
# Leave it blank to use the database default collection.
HYDRADB_COLLECTION=
HYDRADB_API_URL=https://api.hydradb.com

# Optional compatibility aliases for existing local environments; prefer the canonical names above for new deployments.
HYDRADB_TENANT_ID=
HYDRADB_SUB_TENANT_ID=

# Optional public-safe canary source ID used only for hosted relation readback.
HYDRADG_PUBLIC_CANARY_SOURCE_ID=

# External retrieval
EXA_API_KEY=
# Tavily: tvly CLI uses OAuth; @tavily/ai-sdk (Vercel AI SDK tools) needs API key.
# Docs: https://docs.tavily.com/documentation/integrations/vercel
TAVILY_API_KEY=

# AIsa — OpenAI-compatible model gateway + data APIs / Skills.
# Docs: https://aisa.one/docs/agent-quickstart.md
# Never commit the value. Bearer auth. Prefer free/unlocked models until balance topped up.
AISA_API_KEY=
AISA_API_URL=https://api.aisa.one/v1
AISA_APIS_URL=https://api.aisa.one/apis/v1
# Verified chat model on this account (recharge may be required for premium IDs).
AISA_DEFAULT_MODEL=qwen-flash

# Compute integrations: surfaced as configured/unconfigured in MVP.
# Invocation stays server-side and must be explicitly enabled before use.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Mitosis Labs (Cortex memory / Yappy agents via mi CLI + @mitosislabs/sdk).
# Headless auth: set MI_API_KEY=mi_... from https://mitosislabs.ai (user menu → Copy API Key).
# Or run: mi login  (browser OAuth) / mi login --token <key>
# Docs: https://mitosislabs.ai/developers/cli/overview
# Invocation stays server-side; external Cortex memory is NOT canonical FCG.
MI_API_KEY=
# Optional: default office id from `mi offices list` (JSON .[0].id)
MI_OFFICE_ID=

# Tenki Sandbox (P2 sponsor infra). Prefer `tenki login`; optional TENKI_API_KEY=tk_...
# Docs: https://tenki.cloud/docs  |  https://tenki.cloud/docs/sandbox/quickstart
# Not scientific execution authority — magicSTUDIObox remains compute host of record.
TENKI_API_KEY=

GMI_API_KEY=
GMI_API_BASE=https://console.gmicloud.ai/api/v1
MODAL_ENDPOINT_URL=
MODAL_PROXY_TOKEN=

# Runtype (HydraLamp live multi-model custody). Server-side only.
# Never commit the value. Never expose to browser or model context.
# Keep exactly one non-empty RUNTYPE_API_KEY= line (last line wins if duplicated).
RUNTYPE_API_KEY=
RUNTYPE_API_URL=https://api.runtype.com
# Optional spend gate (USD). Do not enable automatic recharge.
HYDRALAMP_DEMO_COST_CAP_USD=
